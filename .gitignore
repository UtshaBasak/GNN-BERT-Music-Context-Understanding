# =============================================================================
# gnn-bert-music-context
#
# Keep this file current. When you add a tool, a cache or a credential file,
# add it here in the same commit -- a secret is only secret until its first
# push, and `git rm --cached` does not remove it from history.
#
# Quick audit before any push:
#   git status --porcelain          # nothing unexpected staged
#   git ls-files | xargs du -ch | tail -1   # total size sanity check
#   git check-ignore -v <path>      # why is this path (not) ignored?
# =============================================================================

# -----------------------------------------------------------------------------
# SECRETS AND CREDENTIALS -- never commit any of these
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
secrets.*
secrets/
credentials*
!credentials*.example
service-account*.json
client_secret*.json

# keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ecdsa*
id_ed25519*
*.ppk
.ssh/

# service credentials this project could plausibly touch
kaggle.json
.kaggle/
.netrc
_netrc
.aws/
.gcloud/
.azure/
.huggingface/
huggingface_token*
wandb/settings
.wandb_api_key
*token.txt
*_token
.git-credentials

# local machine overrides (may hold paths, hosts or keys)
config.local.yaml
config.*.local.yaml
settings.local.json
.claude/settings.local.json
local_settings.py

# -----------------------------------------------------------------------------
# DATASETS -- read-only inputs, far too large for git, and mostly redistributable
# only under their own licences. Never push audio.
# -----------------------------------------------------------------------------
data/raw/
# The corpora also live beside the repo on this machine; if this ignore file is
# ever reused one level up, these names keep the datasets out by themselves.
DEAM/
FMA/
MagnaTagATune/
MusicCaps/
Lakh MIDI/
lmd_clean/
fma_small/
fma_metadata/
fma_full/
fma_large/
musiccaps_audio/
MEMD_audio/
merged_mp3/
clean_midi/

# derived caches: regenerate with `make features` / `make graphs`
data/processed/*
# ...except the sample graphs, which are a graded submission deliverable
!data/processed/sample_graphs/

# -----------------------------------------------------------------------------
# MEDIA, CACHES AND CHECKPOINTS
# -----------------------------------------------------------------------------
*.mp3
*.wav
*.flac
*.m4a
*.ogg
*.opus
*.au
*.mid
*.midi
*.h5
*.hdf5
*.npy
*.npz
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
# ...the one exception, re-included after the *.pt rule above
!data/processed/sample_graphs/*.pt

# A7.2/A7.4 build artifacts, both covered by the rules above but named here so
# it is obvious they are deliberate rather than overlooked:
#   data/processed/mels_full_*.h5   full-resolution mel cache, 5.8 GB
#                                   (rebuild: scripts/build_mel_cache.py)
#   results/scores/

# The prescribed directory tree has to survive a fresh clone, so the two
# directories that are otherwise empty or ignored keep a committed placeholder.
# A grader cloning the repo should see the structure, not a missing folder.
!data/raw/README.md
!results/retrieval_examples/
!results/retrieval_examples/.gitkeep

# B4 listening study. The HTML page embeds ~24 x 10 s MP3 clips as base64, so it
# is audio in a text file and falls under the no-audio rule; the sheet key,
# question list and de-identified ratings ARE committed, because they are what
# makes the study reproducible.
data/human_eval/listening_page.html
data/human_eval/*.mp3
data/human_eval/*.wav

# Per-run val/test score matrices (*.npz), the inputs to
# scripts/threshold_bootstrap.py. The bootstrap RESULT
# (results/threshold_bootstrap.json) is committed; the matrices it consumes are
# not -- they are large and regenerable from the checkpoints.
results/scores/

# -----------------------------------------------------------------------------
# EXPERIMENT TRACKING, LOGS AND BUILD ARTIFACTS
# -----------------------------------------------------------------------------
wandb/
runs/
lightning_logs/
mlruns/
logs/
results/checkpoints/
# Quarantined synthetic-smoke artifacts (see its README). Never submitted.
results/_synthetic_smoke/

# Run telemetry: queue state, probe outputs, per-run logs and upload manifests.
# The scripts that write these create the directory on demand, so it is a build
# artifact rather than source and does not belong in version control.
state/

# upload payloads are rebuilt on demand by scripts/make_kaggle_payload.py
kaggle_payload*.tar.gz
*.tar.gz
*.tgz
*.zip
*.7z
*.rar

# -----------------------------------------------------------------------------
# PYTHON
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/
.python-version

# virtual environments
.venv/
venv/
env/
ENV/
.conda/

# -----------------------------------------------------------------------------
# EDITORS AND OS
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# submission bundle, rebuilt on demand
submission_*.zip
